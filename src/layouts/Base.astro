---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BeeFlight from '../components/BeeFlight.astro';
import ToTop from '../components/ToTop.astro';
import { site } from '../lib/site';
// Fonts used above the fold. Preloading them means text paints in its final face
// instead of a fallback that swaps (and shifts the header) a moment later.
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import displayUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import displayItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2?url';
import labelUrl from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';
import labelBoldUrl from '@fontsource/courier-prime/files/courier-prime-latin-700-normal.woff2?url';

const preloadFonts = [sansUrl, displayUrl, displayItalicUrl, labelUrl, labelBoldUrl];

interface Props {
  title?: string;
  description?: string;
  dark?: boolean;
}

const { title, description = site.description, dark = false } = Astro.props;
const fullTitle = title ? `${title} · huni (concept)` : 'huni · pure beauty, powered by bees (concept)';
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f1e7" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={['min-h-dvh overflow-x-clip', dark && 'bg-ink text-cream']}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-comb focus:px-4 focus:py-2">
      Skip to content
    </a>
    <Header />
    <BeeFlight />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <ToTop />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
