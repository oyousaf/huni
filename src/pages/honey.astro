---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import dripImg from '../assets/images/honey-drip.jpg';
import spoonImg from '../assets/images/honey-jar-spoon.jpg';

const glossary = [
  { term: 'Organic raw honey', what: 'Unheated, unfiltered honey from a single region of Yucatán.', why: 'A humectant that draws moisture into hair and skin, with natural enzymes and antioxidants intact.' },
  { term: 'Keratin', what: 'The structural protein hair is made of.', why: 'Fills weak spots along the strand so it feels stronger and smoother.' },
  { term: 'Botanical oils', what: 'Plant oils pressed for richness.', why: 'Seal in the moisture honey draws in, and add slip and shine.' },
  { term: 'Wildflower extract', what: 'Extract from the flowers the bees forage on.', why: 'A softening, skin-friendly botanical that ties the formula back to the hive.' },
];

const compost = [
  { step: 'Rinse', copy: 'Rinse the empty bottle with warm water.' },
  { step: 'Cut', copy: 'Cut it into strips so microbes have more surface to work on.' },
  { step: 'Compost', copy: 'Add the strips to a home compost heap with garden and food waste.' },
  { step: 'Wait', copy: 'Within months it breaks down with everything else. The cap goes in recycling.' },
];
---

<Base title="Our honey" description="Why raw honey is the working ingredient in every huni formula — plus the ingredient glossary and composting guide.">
  <PageHero label="Our honey" title="Not for the label. <em>For the result.</em>" intro="Most beauty brands use honey as a word on the front of the bottle. We build the formula around it." image={dripImg} />

  <section class="wrap grid items-center gap-14 py-24 lg:grid-cols-[1fr_1.1fr]">
    <Image src={spoonImg} alt="A jar of dark raw honey with a wooden dipper" widths={[600, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-square w-full rounded-[2.5rem] object-cover" data-reveal />
    <div>
      <SectionHead label="The science, simply" title="Honey holds on to <em>water</em>." />
      <div class="mt-8 grid gap-5 text-ink-soft" data-reveal>
        <p>Honey is a humectant: its natural sugars pull moisture from the air and hold it against hair and skin. Raw honey keeps the enzymes and antioxidants that heat-treated honey loses.</p>
        <p>That's why we use it raw, single-origin and high in the formula — where it can actually do something.</p>
      </div>
    </div>
  </section>

  <section class="bg-wax py-24">
    <div class="wrap">
      <SectionHead label="Ingredient glossary" title="Everything in the bottle, and <em>why</em>." />
      <dl class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-stone bg-stone sm:grid-cols-2">
        {
          glossary.map((g, i) => (
            <div class="bg-cream p-8" data-reveal data-delay={(i % 2) * 0.08}>
              <dt class="font-display text-2xl">{g.term}</dt>
              <dd class="mt-3 text-sm text-ink-soft">{g.what}</dd>
              <dd class="mt-3 border-t border-stone pt-3 text-sm"><span class="label mr-2">Why</span>{g.why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap py-24">
    <SectionHead label="Vivomer™ bottle" title="When it's empty, <em>compost</em> it.">
      <p class="mt-5 text-ink-soft">The bottle is made from a home-compostable material, so it can go on a garden heap rather than to landfill.</p>
    </SectionHead>
    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        compost.map((c, i) => (
          <li class="rounded-3xl border border-stone p-7" data-reveal data-delay={i * 0.08}>
            <span class="hex-clip grid size-12 place-items-center bg-comb font-label font-bold">{i + 1}</span>
            <h3 class="mt-5 text-xl">{c.step}</h3>
            <p class="mt-2 text-sm text-ink-soft">{c.copy}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 font-label text-[11px] text-ink/60">Concept note: a real launch should name the certification behind “home compostable” (e.g. TÜV OK compost HOME).</p>
  </section>
</Base>
