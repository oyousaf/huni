---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import HexStat from '../components/HexStat.astro';
import DripEdge from '../components/DripEdge.astro';
import JoinForm from '../components/JoinForm.astro';
import ProductCard from '../components/ProductCard.astro';
import { range } from '../lib/range';
import { getCorridorPins, getMayanBee, getMeridaWeather } from '../lib/data';

import heroImg from '../assets/images/honey-jar-comb.jpg';
import dripImg from '../assets/images/honey-drip.jpg';
import forestImg from '../assets/images/yucatan-forest.jpg';
import combImg from '../assets/images/comb-frame.jpg';

const [bee, weather, pins] = await Promise.all([getMayanBee(), getMeridaWeather(), getCorridorPins()]);

const pillars = [
  { title: 'Organic raw honey', copy: 'Single-origin, unheated and traceable from hive to bottle.' },
  { title: 'Made by hand in Mérida', copy: 'Small batches, close to the beekeepers who make it possible.' },
  { title: 'Home-compostable bottle', copy: 'Breaks down in a garden compost heap. No special facility needed.' },
];

const benefits = [
  { n: '01', title: 'Deep hydration', copy: 'Honey is a natural humectant: it draws water in and holds it there.' },
  { n: '02', title: 'Smooth, soft hair', copy: 'Sugars and enzymes help seal the cuticle so strands catch the light.' },
  { n: '03', title: 'Natural protection', copy: 'Raw honey carries antioxidants that help shield hair and skin.' },
];
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ink text-cream">
    <Image
      src={heroImg}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover opacity-70"
      data-parallax
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/75 to-ink/10"></div>
    <div class="wrap flex min-h-[86svh] flex-col justify-center py-24">
      <p class="label-light" data-reveal>Chapter one · Yucatán, Mexico</p>
      <h1 class="mt-6 max-w-3xl text-5xl leading-[0.98] font-light tracking-tight sm:text-7xl lg:text-8xl" data-reveal data-delay="0.1">
        Honey that <em class="text-comb">earns</em> its place on the shelf.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-cream/80" data-reveal data-delay="0.2">
        Hair and body care built around organic raw honey from Mayan beekeepers we know by name. Not a label
        ingredient — the reason the formula works.
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal data-delay="0.3">
        <a href="/join" class="btn-honey">Join the hive →</a>
        <a href="/honey" class="btn-ghost text-cream hover:bg-cream! hover:text-ink!">Why honey works</a>
      </div>
    </div>
  </section>
  <DripEdge class="-mt-px bg-cream" />

  <!-- Pillars -->
  <section class="wrap grid gap-10 py-16 sm:grid-cols-3">
    {
      pillars.map((p, i) => (
        <div class="border-t border-ink/15 pt-6" data-reveal data-delay={i * 0.08}>
          <p class="label">0{i + 1}</p>
          <h3 class="mt-3 text-2xl">{p.title}</h3>
          <p class="mt-2 text-ink-soft">{p.copy}</p>
        </div>
      ))
    }
  </section>

  <!-- The range -->
  <section class="relative bg-wax py-24">
    <div class="wrap">
      <SectionHead label="The first chapter" title="Six formulas. <em>One</em> hero ingredient." center>
        <p class="mt-5 text-ink-soft">A short, honest range for hair and body — each one built around raw honey, not decorated with it.</p>
      </SectionHead>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {range.map((p, i) => <ProductCard product={p} delay={(i % 3) * 0.1} />)}
      </div>
      <p class="mt-10 text-center"><a href="/shop" class="font-label text-sm underline decoration-comb decoration-2 underline-offset-4">See the range &amp; sets →</a></p>
    </div>
  </section>

  <!-- Why honey works -->
  <section class="wrap grid items-center gap-14 py-24 lg:grid-cols-2">
    <div class="relative" data-reveal>
      <Image src={dripImg} alt="Raw honey dripping from a honey extractor" widths={[600, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/5] w-full rounded-[2.5rem] object-cover object-[50%_90%]" />
      <Image src={combImg} alt="A beekeeper holding a frame of capped honeycomb" widths={[400, 700]} sizes="240px" class="hex-clip absolute -right-4 -bottom-10 hidden w-60 object-cover sm:block" />
    </div>
    <div>
      <SectionHead label="Why honey works" title="Most honey in beauty is <em>decorative</em>. Ours does the work." />
      <ol class="mt-10 grid gap-8">
        {
          benefits.map((b, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-5" data-reveal data-delay={i * 0.08}>
              <span class="font-label text-sm text-propolis">{b.n}</span>
              <div>
                <h3 class="text-xl">{b.title}</h3>
                <p class="mt-1 text-ink-soft">{b.copy}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Origin -->
  <section class="relative isolate overflow-hidden text-cream">
    <Image src={forestImg} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-jungle-deep via-jungle-deep/70 to-jungle-deep/20"></div>
    <div class="wrap flex min-h-[70svh] flex-col justify-end py-20">
      <SectionHead label="Origin" title="We went to Yucatán for the honey. We stayed for the <em>people</em>." light>
        <p class="mt-5 max-w-xl text-cream/80">
          In the forests around Mérida, Mayan families have kept bees for generations — including the stingless
          <em>xunan kab</em>, the “royal lady bee”. Every batch is single-origin and traceable to the hive.
        </p>
        <a href="/origin" class="btn-honey mt-8">Meet the beekeepers →</a>
      </SectionHead>
    </div>
  </section>

  <!-- Pollinator Index teaser: real data, fetched at build -->
  <section class="hex-bg bg-ink py-24 text-cream">
    <div class="wrap">
      <SectionHead label="Pollinator Index · live data" title="Every bottle should leave the world <em>busier</em>." light center>
        <p class="mt-5 text-cream/70">Real, open data from GBIF, Open-Meteo and our planting corridor — not numbers typed into a page.</p>
      </SectionHead>
      <div class="mt-16 grid grid-cols-2 gap-y-14 lg:grid-cols-4">
        <HexStat value={bee.mexico} label="Recorded sightings of the Mayan stingless bee in Mexico" source="GBIF" />
        <HexStat value={bee.yucatan} label="…of which recorded in Yucatán" source="GBIF" delay={0.08} />
        <HexStat value={Math.round(weather.temp)} suffix="°" label="In Mérida right now — prime foraging warmth" source="Open-Meteo" delay={0.16} />
        <HexStat value={pins.length} label="Patches pinned on the planting corridor" source="huni corridor API" delay={0.24} />
      </div>
      <p class="mt-14 text-center">
        <a href="/pollinator-index" class="btn-honey">Open the Pollinator Index →</a>
      </p>
    </div>
  </section>

  <!-- Join -->
  <section class="wrap grid items-center gap-12 py-24 lg:grid-cols-2">
    <SectionHead label="Join the hive" title="Be one of the <em>first</em> to try it." >
      <p class="mt-5 text-ink-soft">One list, three perks: launch access, a packet of wildflower seeds for your patch, and a weekly sample-pack draw until launch.</p>
    </SectionHead>
    <div data-reveal data-delay="0.1"><JoinForm /></div>
  </section>
</Base>
