---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import HexStat from '../components/HexStat.astro';
import { getCorridorPins, getMayanBee, getMeridaWeather } from '../lib/data';
import { faoMexico as fao } from '../lib/fao';

const [bee, weather, pins] = await Promise.all([getMayanBee(), getMeridaWeather(), getCorridorPins()]);
const builtAt = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Pollinator Index" description="Live, open pollinator data: Mayan bee records from GBIF, bee sightings from iNaturalist, Mérida weather and the huni planting corridor.">
  <PageHero label="Pollinator Index" title="Scan your bottle. <em>See the bees.</em>" intro="Every number on this page comes from an open, public data source — refreshed live in your browser." />

  <section class="wrap py-20">
    <div class="grid grid-cols-2 gap-y-14 lg:grid-cols-4">
      <HexStat value={bee.mexico} label="Recorded sightings of the Mayan stingless bee in Mexico" source="GBIF" />
      <HexStat value={bee.yucatan} label="…recorded in Yucatán, where our honey comes from" source="GBIF" delay={0.08} />
      <HexStat value={pins.length} label="Patches pinned on the planting corridor" source="huni corridor API" delay={0.16} />
      <HexStat value={1} suffix="%" label="Of profit pledged to pollinator projects" source="Brand pledge" delay={0.24} />
    </div>
    <p class="mt-12 text-center font-label text-[11px] text-ink/60">Snapshot built {builtAt}{!bee.live && ' · GBIF offline at build, showing saved figures'}.</p>
  </section>

  <!-- Mexico's honey: FAOSTAT -->
  <section class="hex-bg bg-jungle-deep py-24 text-cream">
    <div class="wrap">
      <SectionHead label="Mexico's honey · FAOSTAT" title="A top-ten honey nation, <em>hive by hive</em>." light center>
        <p class="mt-5 text-cream/70">
          Mexico produced {fao.honeyTonnes1961.toLocaleString('en-GB')} tonnes of honey in 1961. By 2024 that had more than doubled.
        </p>
      </SectionHead>
      <div class="mt-16 grid gap-y-14 sm:grid-cols-3">
        <HexStat value={fao.honeyTonnes.value} label={`Tonnes of natural honey produced in ${fao.honeyTonnes.year}`} source={fao.source} />
        <HexStat value={fao.worldRank.value} prefix="#" label={`Mexico's place among the world's honey producers, ${fao.worldRank.year}`} source={fao.source} delay={0.08} />
        <HexStat value={fao.beehives.value / 1e6} decimals={1} suffix="M" label={`Beehives kept across Mexico (${fao.beehives.value.toLocaleString('en-GB')}, ${fao.beehives.year})`} source={fao.source} delay={0.16} />
      </div>
      <p class="mt-14 text-center font-label text-[11px] text-cream/50">
        Source: <a href={fao.url} rel="noopener" class="underline underline-offset-4">FAOSTAT, Crops and livestock products</a> · latest official figures.
      </p>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-wax py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead label="The map" title="From the forest to <em>your</em> street." />
        <div class="flex gap-2 font-label text-xs" role="group" aria-label="Map view">
          <button type="button" data-view="yucatan" class="map-view rounded-full border border-ink/20 px-4 py-2 aria-pressed:bg-ink aria-pressed:text-cream" aria-pressed="true">Yucatán</button>
          <button type="button" data-view="corridor" class="map-view rounded-full border border-ink/20 px-4 py-2 aria-pressed:bg-ink aria-pressed:text-cream" aria-pressed="false">Corridor</button>
        </div>
      </div>
      <div
        id="bee-map"
        class="mt-10 h-[60svh] min-h-96 overflow-hidden rounded-4xl border border-stone bg-stone"
        data-bees={JSON.stringify(bee.points)}
        data-pins={JSON.stringify(pins)}
      ></div>
      <ul class="mt-5 flex flex-wrap gap-6 font-label text-xs text-ink-soft">
        <li class="flex items-center gap-2"><span class="size-3 rounded-full bg-honey"></span>Mayan stingless bee record (GBIF)</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-full bg-jungle"></span>Corridor patch (huni)</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-full border-2 border-propolis bg-comb"></span>Your patch (this browser)</li>
      </ul>
    </div>
  </section>

  <!-- Plant your patch + bees near you -->
  <section class="wrap grid gap-10 py-24 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <SectionHead label="Plant your patch" title="How busy is <em>your</em> corner?">
        <p class="mt-5 text-ink-soft">Type your town or city. We'll count real wild bee sightings recorded near you this year on iNaturalist, and drop your patch on the corridor.</p>
      </SectionHead>
      <form id="patch-form" class="mt-8 flex max-w-lg flex-col gap-2 rounded-4xl border border-ink/15 bg-wax p-2 sm:flex-row sm:rounded-full" data-reveal>
        <label for="patch-city" class="sr-only">Town or city</label>
        <input id="patch-city" required placeholder="e.g. Manchester" class="min-w-0 flex-1 bg-transparent px-5 py-3 outline-none placeholder:text-ink/40" />
        <button class="btn-honey justify-center">Plant my patch →</button>
      </form>
      <p id="patch-status" class="mt-5 min-h-6 text-ink-soft" role="status" aria-live="polite"></p>
      <p class="font-label text-[10px] text-ink/50">Concept demo: your patch is saved in this browser only. Nothing is sent to huni.</p>
    </div>

    <aside class="hex-bg rounded-4xl bg-jungle-deep p-8 text-cream" data-reveal data-delay="0.1">
      <p class="label-light">Hive weather · Mérida</p>
      <p class="mt-6 font-display text-7xl font-light"><span id="wx-temp">{Math.round(weather.temp)}</span>°C</p>
      <dl class="mt-6 grid grid-cols-2 gap-4 font-label text-sm">
        <div><dt class="text-cream/60">Rain</dt><dd><span id="wx-rain">{weather.rain}</span> mm</dd></div>
        <div><dt class="text-cream/60">Wind</dt><dd><span id="wx-wind">{Math.round(weather.wind)}</span> km/h</dd></div>
      </dl>
      <p id="wx-note" class="mt-6 text-sm text-cream/75"></p>
      <p class="mt-6 font-label text-[10px] text-cream/50">Source: Open-Meteo, refreshed when you open this page.</p>
    </aside>
  </section>
</Base>

<script>
  import { countBeeSightings, geocode, getMeridaWeather } from '../lib/data';
  import { inView } from 'motion';

  type Pin = { lat: number; lng: number; label: string };
  const KEY = 'huni-patches';
  const mine = (): Pin[] => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; }
  };

  // Live weather refresh, with a plain-English foraging note.
  getMeridaWeather().then((w) => {
    if (!w.live) return;
    document.getElementById('wx-temp')!.textContent = String(Math.round(w.temp));
    document.getElementById('wx-rain')!.textContent = String(w.rain);
    document.getElementById('wx-wind')!.textContent = String(Math.round(w.wind));
    document.getElementById('wx-note')!.textContent =
      w.rain > 0.5 ? 'Rain in Mérida — the bees are staying home today.'
      : w.wind > 25 ? 'Windy — only the bravest foragers are out.'
      : w.temp >= 20 ? 'Warm and dry: good foraging weather.'
      : 'Cool for Yucatán — a slow morning in the hives.';
  });

  // Leaflet only loads once the map scrolls into view.
  const mapEl = document.getElementById('bee-map')!;

  inView(mapEl, () => {
    (async () => {
      const L = (await import('leaflet')).default;
      await import('leaflet/dist/leaflet.css');
      const map = L.map(mapEl, { scrollWheelZoom: false }).setView([20.6, -89], 7);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
        className: 'honey-tiles',
      }).addTo(map);

      const bees: [number, number][] = JSON.parse(mapEl.dataset.bees ?? '[]');
      bees.forEach((p) => L.circleMarker(p, { radius: 5, color: '#8a4a12', weight: 1, fillColor: '#c77b1e', fillOpacity: 0.75 }).addTo(map));

      const pins: Pin[] = JSON.parse(mapEl.dataset.pins ?? '[]');
      const corridor = pins.map((p) =>
        L.circleMarker([p.lat, p.lng], { radius: 6, color: '#1f3328', weight: 1, fillColor: '#2f4a3a', fillOpacity: 0.85 }).bindTooltip(p.label).addTo(map),
      );

      const addMine = (p: Pin) => {
        L.circleMarker([p.lat, p.lng], { radius: 8, color: '#8a4a12', weight: 2, fillColor: '#e0a526', fillOpacity: 1 }).bindTooltip(`Your patch · ${p.label}`).addTo(map);
      };
      mine().forEach(addMine);

      const views = {
        yucatan: () => map.flyTo([20.6, -89], 7),
        corridor: () => {
          const all = [...corridor.map((m) => m.getLatLng()), ...mine().map((p) => L.latLng(p.lat, p.lng))];
          if (all.length) map.flyToBounds(L.latLngBounds(all).pad(0.3));
        },
      };
      document.querySelectorAll<HTMLButtonElement>('.map-view').forEach((btn) =>
        btn.addEventListener('click', () => {
          document.querySelectorAll('.map-view').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          views[btn.dataset.view as keyof typeof views]();
        }),
      );
      document.addEventListener('patch:planted', (e) => {
        const p = (e as CustomEvent<Pin>).detail;
        addMine(p);
        map.flyTo([p.lat, p.lng], 10);
      });
    })();
  });

  // Plant a patch: geocode, count real bee sightings nearby, save locally.
  const form = document.getElementById('patch-form') as HTMLFormElement;
  const status = document.getElementById('patch-status')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = (document.getElementById('patch-city') as HTMLInputElement).value.trim();
    if (!q) return;
    status.textContent = 'Looking for bees…';
    try {
      const place = await geocode(q);
      if (!place) { status.textContent = `We couldn't find “${q}”. Try a nearby town.`; return; }
      const since = `${new Date().getFullYear()}-01-01`;
      const count = await countBeeSightings(place.lat, place.lng, 15, since);
      const pin = { lat: place.lat, lng: place.lng, label: `${place.name}, ${place.country}` };
      try { localStorage.setItem(KEY, JSON.stringify([...mine(), pin])); } catch {}
      document.dispatchEvent(new CustomEvent('patch:planted', { detail: pin }));
      status.innerHTML = `<strong class="text-ink">${count.toLocaleString('en-GB')}</strong> wild bee sightings recorded within 15 km of ${place.name} this year. Your patch is on the map.`;
    } catch {
      status.textContent = 'The bee counters are busy. Try again in a moment.';
    }
  });
</script>
