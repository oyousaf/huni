---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap grid min-h-[70svh] place-items-center py-24 text-center">
    <div>
      <p class="label">404</p>
      <h1 class="mt-5 text-5xl font-light sm:text-7xl">This bee <em class="text-honey">flew off</em>.</h1>
      <a href="/" class="btn-honey mt-10">Back to the hive →</a>
    </div>
  </section>
</Base>
