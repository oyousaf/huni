---
// Text wordmark with a hex-cell mark. Deliberately not the real brand's logo.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
    <path d="M16 2 28 9v14l-12 7-12-7V9z" fill="var(--color-comb)" />
    <path d="M16 9.5 22 13v6.5L16 23l-6-3.5V13z" fill="currentColor" />
  </svg>
  <span class="font-display text-2xl italic leading-none tracking-tight" style="font-variation-settings:'SOFT' 100,'WONK' 1">huni</span>
</span>
