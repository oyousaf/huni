---
// A single line-drawn bee tracing a dotted path down the right edge as you scroll.
---

<div id="flight" class="pointer-events-none fixed top-0 right-2 z-30 hidden h-dvh w-16 lg:block" aria-hidden="true">
  <svg class="absolute inset-0 size-full" viewBox="0 0 64 1000" preserveAspectRatio="none">
    <path
      id="flight-path"
      d="M40 20 C 10 120, 58 200, 30 300 S 50 480, 24 560 S 56 760, 34 840 S 20 940, 36 985"
      fill="none"
      stroke="var(--color-honey)"
      stroke-opacity=".35"
      stroke-width="1.2"
      stroke-dasharray="2 7"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  <!-- Top-down bee facing +x; motion.ts rotates it to the path heading. -->
  <svg id="flight-bee" class="absolute top-0 left-0 size-7" viewBox="-12 -12 24 24">
    <ellipse cx="-1" cy="-5.5" rx="4.6" ry="2.8" fill="var(--color-wax)" stroke="var(--color-ink)" stroke-width=".7" transform="rotate(-20 -1 -5.5)" />
    <ellipse cx="-1" cy="5.5" rx="4.6" ry="2.8" fill="var(--color-wax)" stroke="var(--color-ink)" stroke-width=".7" transform="rotate(20 -1 5.5)" />
    <ellipse cx="0" cy="0" rx="7" ry="4" fill="var(--color-comb)" stroke="var(--color-ink)" stroke-width=".8" />
    <path d="M-2 -3.8v7.6M1.4 -3.9v7.8" stroke="var(--color-ink)" stroke-width="1.2" />
    <circle cx="8" cy="0" r="2.2" fill="var(--color-ink)" />
  </svg>
</div>
