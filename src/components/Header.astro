---
import Logo from './Logo.astro';
import { nav } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-stone/70 bg-cream/85 backdrop-blur-md">
  <!-- Three-column grid keeps the nav centred no matter how wide the logo or button render. -->
  <div class="wrap grid h-16 grid-cols-[1fr_auto] items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
    <a href="/" aria-label="huni home" class="justify-self-start"><Logo /></a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="relative py-1 transition-colors hover:text-propolis aria-[current=page]:text-propolis after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3 justify-self-end">
      <a href="/join" class="btn-honey hidden px-5! py-2.5! sm:inline-flex">Join the hive</a>

      <div class="mobile-menu group relative md:hidden" data-open="false">
        <button
          type="button"
          class="menu-toggle relative flex size-10 items-center justify-center rounded-full border border-ink/20 transition-colors group-data-[open=true]:bg-ink group-data-[open=true]:text-cream"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="absolute h-[1.5px] w-4 -translate-y-1 rounded-full bg-current transition-[translate,rotate] duration-300 ease-honey group-data-[open=true]:translate-y-0 group-data-[open=true]:rotate-45 motion-reduce:transition-none"></span>
          <span class="absolute h-[1.5px] w-4 translate-y-1 rounded-full bg-current transition-[translate,rotate] duration-300 ease-honey group-data-[open=true]:translate-y-0 group-data-[open=true]:-rotate-45 motion-reduce:transition-none"></span>
        </button>

        <nav
          id="mobile-nav"
          aria-label="Mobile"
          inert
          class="invisible absolute top-full right-0 mt-3 w-64 origin-top-right -translate-y-2 scale-95 rounded-2xl border border-stone bg-wax p-3 opacity-0 shadow-xl transition-[opacity,translate,scale,visibility] duration-250 ease-honey group-data-[open=true]:visible group-data-[open=true]:translate-y-0 group-data-[open=true]:scale-100 group-data-[open=true]:opacity-100 motion-reduce:transition-none"
        >
          <ul class="grid gap-1">
            {
              [...nav, { href: '/join', label: 'Join the hive' }].map((item, i) => (
                <li
                  class="-translate-y-1 opacity-0 transition-[opacity,translate] duration-300 ease-honey group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100 motion-reduce:transition-none"
                  style={`transition-delay: calc(var(--menu-stagger, 0ms) * ${i})`}
                >
                  {item.href === '/join' ? (
                    <a href={item.href} class="btn-honey mt-2 w-full justify-center">{item.label}</a>
                  ) : (
                    <a href={item.href} aria-current={path === item.href ? 'page' : undefined} class="block rounded-xl px-4 py-3 hover:bg-cream aria-[current=page]:text-propolis">
                      {item.label}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  const toggle = menu?.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = menu?.querySelector<HTMLElement>('#mobile-nav');

  if (menu && toggle && panel) {
    const set = (open: boolean) => {
      menu.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.inert = !open;
      // Links cascade in on open; close all at once.
      menu.style.setProperty('--menu-stagger', open ? '40ms' : '0ms');
    };

    toggle.addEventListener('click', () => set(menu.dataset.open !== 'true'));
    document.addEventListener('click', (e) => {
      if (menu.dataset.open === 'true' && !menu.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') {
        set(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
