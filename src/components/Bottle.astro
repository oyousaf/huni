---
// Concept illustration of the home-compostable bottle.
interface Props {
  name: string;
  tint: string;
  class?: string;
}
const { name, tint, class: className } = Astro.props;
const id = `g-${name.toLowerCase().replace(/[^a-z]+/g, '-')}`;
---

<svg viewBox="0 0 120 260" class={className} role="img" aria-label={`${name} bottle (illustration)`}>
  <defs>
    <linearGradient id={id} x1="0" x2="1">
      <stop offset="0" stop-color={tint} />
      <stop offset=".45" stop-color={tint} stop-opacity=".82" />
      <stop offset="1" stop-color={tint} stop-opacity=".6" />
    </linearGradient>
  </defs>
  <rect x="44" y="6" width="32" height="30" rx="6" fill="var(--color-ink)" />
  <rect x="48" y="34" width="24" height="12" fill="var(--color-ink)" opacity=".85" />
  <path d="M30 70c0-16 12-24 30-24s30 8 30 24v168c0 9-7 16-16 16H46c-9 0-16-7-16-16z" fill={`url(#${id})`} />
  <path d="M38 76c0-9 5-14 12-16" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-linecap="round" fill="none" />
  <rect x="36" y="120" width="48" height="84" rx="3" fill="var(--color-wax)" />
  <path d="M60 132l8 4.6v9.2L60 150.4l-8-4.6v-9.2z" fill="var(--color-comb)" />
  <text x="60" y="170" text-anchor="middle" font-family="Fraunces Variable, serif" font-style="italic" font-size="13" fill="var(--color-ink)">huni</text>
  <text x="60" y="190" text-anchor="middle" font-family="Courier Prime, monospace" font-size="5.4" letter-spacing=".8" fill="var(--color-ink)">{name.replace(/^honey /i, '').toUpperCase()}</text>
</svg>
